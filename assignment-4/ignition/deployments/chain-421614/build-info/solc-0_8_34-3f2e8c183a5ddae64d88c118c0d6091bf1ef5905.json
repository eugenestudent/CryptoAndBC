        "content": "// SPDX-License-Identifier: MIT\r\npragma solidity ^0.8.24;\r\n \r\ncontract Greeter {\r\n    string private greeting;\r\n \r\n    constructor(string memory _name) {\r\n        greeting = string.concat(\"Hello, \", _name, \"!\");\r\n    }\r\n \r\n    function greet() public view returns (string memory) {\r\n        return greeting;\r\n    }\r\n}"
